{
  "name": "rubin-browser",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser for Vera Rubin Observatory public data — images, catalogs, time series, and galaxy analysis",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:geometry": "vitest run tests/unit/projection.test.ts",
    "test:regression": "vitest run tests/regression",
    "test:ui": "playwright test",
    "test:visual": "playwright test tests/ui/visual-regression.spec.ts tests/ui/interaction-outcomes.spec.ts",
    "test:visual:update": "playwright test tests/ui/visual-regression.spec.ts --update-snapshots",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts'",
    "docs:build": "typedoc"
  },
  "keywords": [
    "rubin",
    "lsst",
    "astronomy",
    "data-browser",
    "observatory"
  ],
  "author": "Peter Milford <pmilford@parallel-rules.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hscmap/healpix": "^1.4.12",
    "svelte": "^5.56.4"
  }
}
